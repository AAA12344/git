    "rectificationInProgress": {
      "textColor": "#B45309",
      "backgroundColor": "#FFFBEB"
    },
    "rectificationResultInitial": {
      "textColor": "#C2410C",
      "backgroundColor": "#FFF7ED"
    },
    "rectificationResultApproval": {
      "textColor": "#BE185D",
      "backgroundColor": "#FDF2F8"
    },
    "countersigning": {
      "textColor": "#0F766E",
      "backgroundColor": "#F0FDFA"
    },
    "initialApprovalPending": {
      "textColor": "#6D28D9",
      "backgroundColor": "#F5F3FF"
    },
    "initialApproving": {
      "textColor": "#A21CAF",
      "backgroundColor": "#FDF4FF"
    },
    "rejected": {
      "textColor": "#C2410C",
      "backgroundColor": "#FFF7ED"
    }
