  "statuses": {
    "草稿": "neutral",
    "已驳回": "rejected",
    "待复核": "reviewPending",
    "复核中": "reviewing",
    "待处理": "processPending",
    "处理中": "processing",
    "会签中": "countersigning",
    "待初审": "initialApprovalPending",
    "初审中": "initialApproving",
    "待审批": "approvalPending",
    "审批中": "approving",
    "待补录": "supplement",
    "已办结": "completed",
    "问题待审核": "rectificationIssueReview",
    "方案待提交": "rectificationPlanSubmit",
    "方案待初审": "rectificationPlanInitial",
    "方案待审批": "rectificationPlanApproval",
    "整改中": "rectificationInProgress",
    "结果待初审": "rectificationResultInitial",
    "结果待审批": "rectificationResultApproval",
    "已废止": "danger",
    "审批驳回": "danger",
    "初审驳回": "danger",
    "驳回": "danger",
    "不通过": "danger",
    "未通过": "danger",
    "校验未通过": "danger",
    "未送达": "danger",
    "未接通": "danger",
    "解析失败": "danger",
    "已通过": "success",
    "通过": "success",
    "已联系": "success",
    "已完成": "success",
    "已反馈": "success",
    "已关联": "success",
    "导入成功": "success",
    "导入中": "info",
    "启用": "success",
    "正常": "success",
    "运行中": "success",
    "成功": "success",
    "已配置": "success",
    "停用": "warning",
    "已暂停": "warning",
    "删除": "danger",
    "失败": "danger",
    "待提交": "rejected",
    "问题待提交": "reviewPending"
  },
  "fallbackRules": [
    {
      "keywords": [
        "逾期",
        "驳回",
        "失败",
        "不通过",
        "未送达",
        "未接通",
        "废止"
      ],
      "palette": "danger"
    },
    {
      "keywords": [
        "完成",
        "成功",
        "通过",
        "办结",
        "联系",
        "反馈",
        "关联"
      ],
      "palette": "success"
    },
    {
      "keywords": [
        "审批",
        "审核"
      ],
      "palette": "purple"
    },
    {
      "keywords": [
        "处理中",
        "整改中"
      ],
      "palette": "warning"
    },
    {
      "keywords": [
        "待",
        "提交",
        "导入"
      ],
      "palette": "info"
    }
  ]
}
