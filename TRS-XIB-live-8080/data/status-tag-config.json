{
  "meta": {
    "name": "统一状态标签配置",
    "version": "1.4.0",
    "description": "状态文字、颜色与渲染样式的唯一配置源；页面统一通过 statusTag() 调用。"
  },
  "component": {
    "className": "tag ds-tag is-light status-tag",
    "variant": "light"
  },
  "defaultPalette": "info",
  "palettes": {
    "draft": {
      "textColor": "#667085",
      "backgroundColor": "#F2F4F7"
    },
    "reviewPending": {
      "textColor": "#2563EB",
      "backgroundColor": "#EFF6FF"
    },
    "reviewing": {
      "textColor": "#4F46E5",
      "backgroundColor": "#EEF2FF"
    },
    "processPending": {
      "textColor": "#0891B2",
      "backgroundColor": "#ECFEFF"
    },
    "processing": {
      "textColor": "#B45309",
      "backgroundColor": "#FFFBEB"
    },
    "approvalPending": {
      "textColor": "#7C3AED",
      "backgroundColor": "#F5F3FF"
    },
    "approving": {
      "textColor": "#BE185D",
      "backgroundColor": "#FDF2F8"
    },
    "supplement": {
      "textColor": "#EA580C",
      "backgroundColor": "#FFF7ED"
    },
    "completed": {
      "textColor": "#15803D",
      "backgroundColor": "#F0FDF4"
    },
    "info": {
      "textColor": "#2272DE",
      "backgroundColor": "#E9F1FC"
    },
    "success": {
      "textColor": "#55AA2D",
      "backgroundColor": "#F0F9EB"
    },
    "warning": {
      "textColor": "#C58D00",
      "backgroundColor": "#FEF8E7"
    },
    "danger": {
      "textColor": "#EB4545",
      "backgroundColor": "#FFEEEE"
    },
    "purple": {
      "textColor": "#8157D8",
      "backgroundColor": "#F3EEFD"
    },
    "neutral": {
      "textColor": "#606266",
      "backgroundColor": "#F5F7FA"
    },
    "rectificationIssueReview": {
      "textColor": "#0E7490",
      "backgroundColor": "#ECFEFF"
    },
    "rectificationPlanSubmit": {
      "textColor": "#1D4ED8",
      "backgroundColor": "#EFF6FF"
    },
    "rectificationPlanInitial": {
      "textColor": "#4338CA",
      "backgroundColor": "#EEF2FF"
    },
    "rectificationPlanApproval": {
      "textColor": "#7E22CE",
      "backgroundColor": "#FAF5FF"
